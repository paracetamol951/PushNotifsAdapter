# Copier vers .env. Ne pas versionner les secrets.
# URL PHP : https://push.net-assembly.com:3184/push
# HOST vide : 0.0.0.0 en HTTPS direct, 127.0.0.1 sans certificats (reverse proxy).
HOST=
PORT=3184
# Pour HTTPS directement dans Node, fournir la chaine complete et la cle TLS.
# TLS_CERT_FILE=/etc/letsencrypt/live/push.net-assembly.com/fullchain.pem
# TLS_KEY_FILE=/etc/letsencrypt/live/push.net-assembly.com/privkey.pem
TLS_CERT_FILE=
TLS_KEY_FILE=
# Generer une cle dediee :
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Meme valeur que $pushRelaySecret cote PHP, header X-Internal-Secret.
NODE_INTERNAL_SECRET=
# Reutiliser les valeurs de production :
# PUBLIC_KEY = $pushVapidPublicKey dans includes/pushLocalConfig.php.
# PRIVATE_KEY = $pushVapidPrivateKeyI dans includes/admin.php (base64url).
# PRIVATE_KEY_FILE reste vide dans ce cas ; ce n'est pas le certificat HTTPS.
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
# Alternative a la cle privee base64url : fichier PEM existant.
PUSH_VAPID_PRIVATE_KEY_FILE=
PUSH_VAPID_SUBJECT=mailto:contact@jeu-tarot-en-ligne.com
PUSH_TIMEOUT_MS=8000
PUSH_MAX_CONCURRENT=32
